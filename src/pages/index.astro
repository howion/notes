---
import { NOTE_RECORDS } from "../constants/notes";
import Document from "../layout/document.astro";
---

<Document>
    <main class="content">
        <div class="section-h1">
            <h1>Notes</h1>

            <div class="content-chips">
                <a
                    href="https://github.com/howion/notes/commits/main/"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img
                        src="https://img.shields.io/github/last-commit/howion/notes?style=flat-square&label=last%20commit"
                        alt="Last Commit"
                    />
                </a>
                <a
                    href="https://github.com/howion/notes/graphs/commit-activity"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img
                        src="https://img.shields.io/github/commit-activity/w/howion/notes?style=flat-square"
                        alt="Commit Activity"
                    />
                </a>
                <a href="/rss.xml" target="_blank" rel="noopener noreferrer">
                    <img
                        src="https://img.shields.io/badge/rss-active-brightgreen?style=flat-square"
                        alt="RSS Feed"
                    />
                </a>
            </div>

            {
                NOTE_RECORDS.map((record) => {
                    const children = record.children.filter(
                        (note) => !note.hidden,
                    );

                    if (children.length === 0) {
                        return null;
                    }

                    return (
                        <section class="section-h2">
                            <h2>{record.title}</h2>

                            <ul>
                                {children.map((note) => (
                                    <li>
                                        <a href={`/${note.slug}`}>
                                            {note.title}
                                            <span class="a-secondary">
                                                {note.wip &&
                                                    " — Work In Progress"}
                                            </span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    );
                })
            }
        </div>
    </main>
</Document>
